cd dpcs_deb
rm -rf usr/local/dpcs
mkdir usr/local/dpcs -p
road='usr/local/dpcs'
cp -rf ../$1/* ${road}
cd ..
debname="dpcs_"$subname"_amd64.deb"
dpkg -b dpcs_deb $debname